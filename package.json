{
  "name": "weather-forecast-app",
  "version": "1.0.0",
  "private": true,
  "description": "SPA de pronóstico del clima actual por ciudad (Open-Meteo)",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "VITEST_MODE=all vitest run",
    "test:unit": "VITEST_MODE=unit vitest run",
    "test:property": "VITEST_MODE=property vitest run",
    "test:e2e": "VITEST_MODE=e2e vitest run",
    "eval": "VITEST_MODE=eval vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test && npm run eval"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@types/node": "^22.10.2",
    "fast-check": "^3.23.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
